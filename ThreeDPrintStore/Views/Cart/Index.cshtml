@model List<CartItem>

@{
    decimal subtotal =
        Model.Sum(x => x.Price * x.Quantity);

    decimal shipping =
        subtotal >= 25 ? 0 : 2;

    decimal total =
        subtotal + shipping;
}

<h1>Your Cart</h1>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Each</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>

    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Quantity</td>
            <td>$@item.Price</td>
            <td>$@(item.Price * item.Quantity)</td>
        </tr>
    }

    </tbody>

</table>

<h4>Subtotal:  @Model.Sum(i => i.Price * i.Quantity).ToString("C")</h4>

<p class="text-muted">Shipping calculated at checkout.</p>

<form asp-controller="Cart" asp-action="Checkout" method="post">
    <button type="submit" class="btn btn-primary btn-lg">Proceed to Checkout</button>
</form>