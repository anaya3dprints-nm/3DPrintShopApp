@model List<CartItem>

@{
    decimal subtotal = Model.Sum(x => x.Price * x.Quantity);
    decimal freeShippingThreshold = 50m;
}

<h1>Your Cart</h1>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Each</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <form asp-action="Update" method="post">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <label>Quantity <input type="number" name="quantity" value="@item.Quantity" min="0" max="@ProductCatalog.Find(item.ProductId)!.MaxQuantity" /></label>
                        <button type="submit">Update</button>
                    </form>
                    <form asp-action="Update" method="post">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="hidden" name="quantity" value="0" />
                        <button type="submit">Remove</button>
                    </form>
                </td>
                <td>$@item.Price.ToString("F2")</td>
                <td>$@((item.Price * item.Quantity).ToString("F2"))</td>
            </tr>
        }
    </tbody>
</table>

<form asp-controller="Cart" asp-action="Checkout" method="post">
    <p>US shipping only. Local delivery is not currently available.</p>
    
    <!-- Premium Cache Drop Add-On -->
    <div class="card mb-3 p-3 border-primary">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="includeCacheDrop" name="includeCacheDrop" value="true" onchange="updateCartTotal()">
            <label class="form-check-label fw-bold text-primary" for="includeCacheDrop">
                Add Premium Cache Drop (+$5.00)
            </label>
        </div>
        <div id="premiumFields" style="display:none;">

    <div class="mb-3">
        <label class="form-label">
            Sponsor Name
        </label>
        <input class="form-control"
               name="SponsorName" maxlength="100" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Social Media Handle
        </label>
        <input class="form-control"
               name="SocialHandle" maxlength="100" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Message
        </label>
        <textarea class="form-control"
                  name="SponsorMessage" maxlength="500"></textarea>
    </div>

</div>
        <small class="text-muted">
            Sponsor a hidden 3-inch community 3D model, get a copy with your order, and receive a social media shout-out.
        </small>
    </div>

    <!-- Live Subtotal & Free Shipping Status -->
    <h4>Subtotal: $<span id="display-subtotal" data-base-subtotal="@subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">@subtotal.ToString("F2")</span></h4>

    <p id="free-shipping-msg" class="fw-bold @(subtotal >= freeShippingThreshold ? "text-success" : "text-muted")">
        @if (subtotal >= freeShippingThreshold)
        {
            <span>You qualify for Free Shipping!</span>
        }
        else
        {
            <span>Add $@((freeShippingThreshold - subtotal).ToString("F2")) more for Free Shipping (calculated at checkout).</span>
        }
    </p>

    <button type="submit" class="btn btn-primary btn-lg" disabled="@(Model.Count == 0)">Proceed to Checkout</button>
</form>

<script>
    function updateCartTotal() {
        const checkbox = document.getElementById('includeCacheDrop');
        const subtotalEl = document.getElementById('display-subtotal');
        const msgEl = document.getElementById('free-shipping-msg');

        document.getElementById('premiumFields').style.display = checkbox.checked ? 'block' : 'none';

        const baseSubtotal = parseFloat(subtotalEl.getAttribute('data-base-subtotal'));
        const addOn = checkbox.checked ? 5.00 : 0.00;
        const newSubtotal = baseSubtotal + addOn;

        subtotalEl.textContent = newSubtotal.toFixed(2);

        if (newSubtotal >= 50.00) {
            msgEl.textContent = "You qualify for Free Shipping!";
            msgEl.className = "fw-bold text-success";
        } else {
            const remaining = (50.00 - newSubtotal).toFixed(2);
            msgEl.textContent = `Add $${remaining} more for Free Shipping (calculated at checkout).`;
            msgEl.className = "fw-bold text-muted";
        }
    }
</script>
