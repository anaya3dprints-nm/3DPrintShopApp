<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThreeDPrintStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ThreeDPrintStore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Home">Home</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-flex-grow-1 navbar-nav">
                <li class="nav-item">
                    <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Index">Browse Catalog</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark fw-semibold" asp-controller="Quote" asp-action="RequestForm">Custom Quote Request</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark fw-semibold" asp-controller="Quote" asp-action="Lookup">Track Custom Quote</a>
                </li>

            </ul>
            <!-- Separated administrative layout gateway link -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link text-danger fw-bold border border-danger rounded px-2" asp-controller="Admin" asp-action="Dashboard">🔒 Admin Dashboard</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

        
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ThreeDPrintStore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
