@model ThreeDPrintStore.Models.PrintRequestInput

@{
    ViewData["Title"] = "Custom 3D Print Request";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header">
            <h2>Request A Custom 3D Print</h2>
        </div>

        <div class="card-body">

            <form asp-action="RequestForm"
                  asp-controller="Quote"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName" class="form-control" />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerEmail" class="form-label"></label>
                    <input asp-for="CustomerEmail" class="form-control" />
                    <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                </div>
                <div class="alert alert-info">
                <strong>Size:</strong> 3D model cannot exceed 256mm in any dimension.
                </div>
                <div class="mb-3">
                    <label asp-for="ProjectDescription" class="form-label">
                        Describe Your Project
                    </label>

                    <textarea asp-for="ProjectDescription"
                              class="form-control"
                              rows="5"></textarea>
                    <span asp-validation-for="ProjectDescription" class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                <strong>Material:</strong> All custom prints are currently produced in PLA filament.
                </div>

                <div class="mb-3">
                    <label asp-for="RequestedColorsCount"
                           class="form-label">
                        Number of Colors (4 colors max)
                    </label>

                    <input asp-for="RequestedColorsCount"
                           type="number"
                           min="1"
                           max="4"
                           class="form-control" />
                    <span asp-validation-for="RequestedColorsCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                <label class="form-label">Upload STL, 3MF, or OBJ File</label>
                <input asp-for="ModelFile" type="file"
                    class="form-control"
                    accept=".stl,.3mf,.obj" />
                <div class="form-text">Maximum model size: 25 MB.</div>
                <span asp-validation-for="ModelFile" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ReferenceImage" class="form-label">Upload Reference Image (Optional)</label>
                    <input asp-for="ReferenceImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">Accepted formats: JPG, PNG, WebP, up to 5 MB.</div>
                    <span asp-validation-for="ReferenceImage" class="text-danger"></span>
                </div>


                <button type="submit"
                        class="btn btn-primary">
                    Submit Request
                </button>

            </form>

        </div>
    </div>
</div>