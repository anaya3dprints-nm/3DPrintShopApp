@model ThreeDPrintStore.Models.QuoteRequest

@{
    ViewData["Title"] = "Request a Custom 3D Print";
}

<div class="container my-5" style="max-width: 700px;">
    <div class="card shadow border-0 p-4 rounded-3">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Custom 3D Printing Quote</h2>
            <p class="text-muted">Fill out the specifications below. We will calculate the print time and material metrics to generate your personal quote invoice.</p>
        </div>

        <!-- Note the enctype attribute: crucial for file uploads to work! -->
        <form asp-action="SubmitForm" method="post" enctype="multipart/form-data">
            
            <div class="mb-3">
                <label class="form-label fw-bold">Your Email Address</label>
                <input type="email" asp-for="CustomerEmail" class="form-control shadow-sm" placeholder="name@example.com" required />
                <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Project Description</label>
                <textarea asp-for="Description" class="form-control shadow-sm" rows="4" placeholder="What are you printing? Mention any structural preferences like infill or strength requirements..." required></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Approximate Size</label>
                    <input type="text" asp-for="Size" class="form-control shadow-sm" placeholder="e.g., 10cm x 5cm x 5cm" required />
                    <span asp-validation-for="Size" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Desired Color(s)</label>
                    <input type="text" asp-for="Color" class="form-control shadow-sm" placeholder="e.g., Matte Black" required />
                    <span asp-validation-for="Color" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Filament Material Profile</label>
                <select asp-for="FilamentType" class="form-select shadow-sm">
                    <option value="PLA">PLA (Standard / Decorative)</option>
                    <option value="PETG">PETG (Durable / Outdoor)</option>
                    <option value="TPU">TPU (Flexible / Rubberized)</option>
                    <option value="ABS">ABS (Industrial / Tough)</option>
                </select>
                <span asp-validation-for="FilamentType" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Shipping City</label>
                    <input type="text" asp-for="ShippingCity" class="form-control shadow-sm" placeholder="e.g., Albuquerque" required />
                    <span asp-validation-for="ShippingCity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">ZIP Code</label>
                    <input type="text" asp-for="PostalCode" class="form-control shadow-sm" placeholder="e.g., 87111" required />
                    <span asp-validation-for="PostalCode" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Reference Blueprint / Concept Image</label>
                <input type="file" name="referenceFile" class="form-control shadow-sm" accept="image/*" />
                <div class="form-text text-muted">Upload a clear photo, draft sketch, or render screenshot.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase border-0 shadow-sm" style="background-color: #0d6efd;">
                Submit Quote Request
            </button>
        </form>
    </div>
</div>
