@{
    ViewBag.Title = "Generate Quote";
}

<h2>Generate Custom Print Quote (Admin Only)</h2>

/Quote/ShowQuote
    <div>
        <label>Grams Used</label>
        <input type="number" step="0.01" name="gramsUsed" required />
    </div>

    <div>
        <label>Print Hours</label>
        <input type="number" step="0.01" name="printHours" required />
    </div>

    <button type="submit">Generate Quote</button>
</form>
