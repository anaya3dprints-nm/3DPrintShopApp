@model ThreeDPrintStore.Models.ManualQuoteCalculationViewModel

@{
    ViewData["Title"] = "Calculate Quote";
}

<div class="container mt-4">
    <h2>Calculate Quote Request</h2>
    <p class="text-muted">Enter the slicing metrics (grams and print hours) below to calculate the price, generate a Stripe payment link, and email the quote to the customer.</p>

    <form asp-controller="Quote" asp-action="CreateQuote" method="post" class="mt-3">
        <!-- Hidden fields to preserve tracking info through the form submission -->
        <input type="hidden" asp-for="QuoteRequestId" />
        <input type="hidden" asp-for="CustomerEmail" />
        <input type="hidden" asp-for="Material" />

        <div class="mb-3">
            <label class="form-label">Customer Email</label>
            <input type="text" class="form-control" value="@Model.CustomerEmail" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Material Profile</label>
            <input type="text" class="form-control" value="@Model.Material" disabled />
        </div>

        <div class="mb-3">
            <label asp-for="GramsUsed" class="form-label">Filament Used (Grams)</label>
            <input asp-for="GramsUsed" class="form-control" type="number" step="0.01" placeholder="e.g., 45.5" required />
            <span asp-validation-for="GramsUsed" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PrintHours" class="form-label">Print Time (Hours)</label>
            <input asp-for="PrintHours" class="form-control" type="number" step="0.1" placeholder="e.g., 4.5" required />
            <span asp-validation-for="PrintHours" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Calculate, Generate Stripe Link & Email Quote</button>
        <a asp-controller="Quote" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>