@model IEnumerable<ThreeDPrintStore.Models.QuoteRequest>

@{
    ViewData["Title"] = "Your Quote Status Board";
    var searchedEmail = ViewData["SearchedEmail"] as string;
}

<div class="container my-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark m-0">Your Custom Requests</h2>
            <p class="text-muted mb-0 small">Tracking results recorded for: <strong class="text-primary">@searchedEmail</strong></p>
        </div>
        <a href="/Quote/Lookup" class="btn btn-outline-secondary btn-sm fw-semibold">← Search Again</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-5 border-0 shadow-sm rounded-3">
            <h5 class="fw-bold text-dark mb-1">No Records Found</h5>
            <p class="text-muted small mb-0">We couldn't find any custom slicing print requests filed under that email address. Please make sure there are no spelling mistakes and try again.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var quote in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                        <!-- Dynamic Status Banner Color Coding -->
                        <div class="card-header border-0 d-flex justify-content-between align-items-center py-3 @(quote.Status == "Pending" ? "bg-light-subtle text-dark border-bottom" : "bg-success text-white")">
                            <span class="fw-semibold">Request Blueprint #@quote.Id</span>
                            <span class="badge rounded-pill fw-bold text-uppercase @(quote.Status == "Pending" ? "bg-warning text-dark" : "bg-light text-success")">
                                @quote.Status
                            </span>
                        </div>

                        <div class="card-body p-4 bg-white">
                            <div class="row g-4">
                                <!-- Technical parameters column -->
                                <div class="col-md-7">
                                    <h6 class="fw-bold text-secondary text-uppercase small mb-2">Specifications Provided:</h6>
                                    <p class="text-dark small mb-3" style="white-space: pre-wrap;">@quote.Description</p>
                                    
                                    <div class="row g-2 border-top pt-2">
                                        <div class="col-6 small text-muted">Dimensions: <strong class="text-dark">@quote.Size</strong></div>
                                        <div class="col-6 small text-muted">Material Profile: <strong class="text-dark">@quote.FilamentType</strong></div>
                                        <div class="col-6 small text-muted">Color Target: <strong class="text-dark">@quote.Color</strong></div>
                                        <div class="col-6 small text-muted">Delivery City: <strong class="text-dark">@quote.ShippingCity</strong></div>
                                    </div>
                                </div>

                                <!-- Financial Statement breakdown invoice block -->
                                <div class="col-md-5 bg-light p-3 rounded-3 d-flex flex-column justify-content-center">
                                    @if (quote.Status == "Pending")
                                    {
                                        <div class="text-center p-3 text-muted">
                                            <div class="spinner-border spinner-border-sm text-warning mb-2" role="status"></div>
                                            <div class="fw-bold text-dark small mb-1">Awaiting Slicer Bench Metrics</div>
                                            <p class="mb-0 text-xs text-muted" style="font-size: 0.8rem;">Our studio desk is calculating print speeds and material weight. Refresh this page to track progress!</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <h6 class="fw-bold text-secondary text-uppercase small mb-3">Calculated Invoiced Pricing:</h6>
                                        <div class="d-flex justify-content-between mb-1 small text-muted">
                                            <span>Custom Machine Printing:</span>
                                            <span class="fw-semibold text-dark">$@quote.CalculatedPrice.ToString("F2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom small text-muted">
                                            <span>Fulfillment Routing Fee:</span>
                                            @if (quote.ShippingFee == 0)
                                            {
                                                <span class="text-success fw-bold">Free Local ABQ Delivery</span>
                                            }
                                            else
                                            {
                                                <span class="text-dark fw-bold">$@quote.ShippingFee.ToString("F2")</span>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center text-dark fw-bold fs-5 pt-1">
                                            <span>Total Bill Amount:</span>
                                            <span class="text-success">$@((quote.CalculatedPrice + quote.ShippingFee).ToString("F2"))</span>
                                        </div>
                                        <div class="mt-3">
                                            <button class="btn btn-success btn-sm w-100 fw-bold text-uppercase py-2" onclick="alert('Contact the studio worker with your Request ID #@quote.Id to complete production checkout setup details via email!')">
                                                Proceed with Order
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
