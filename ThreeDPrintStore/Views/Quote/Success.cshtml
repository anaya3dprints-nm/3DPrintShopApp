@{
    ViewData["Title"] = "Request Received";
}

<div class="container my-5 text-center" style="max-width: 550px;">
    <div class="card p-5 border-0 shadow rounded-3">
        <div class="mb-3 text-success">
            <!-- Simple SVG Checkmark Icon -->
            <svg xmlns="http://w3.org" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
        </div>
        <h2 class="fw-bold text-dark mb-2">Inquiry Submitted Successfully!</h2>
        <p class="text-muted mb-4">Thank you for submitting your custom job parameters. Our calibration station will review your requirements, determine operational print limits, and send your finalized calculation review shortly.</p>
        <a href="/" class="btn btn-outline-secondary btn-sm px-4">Return to Catalog Home</a>
    </div>
</div>
