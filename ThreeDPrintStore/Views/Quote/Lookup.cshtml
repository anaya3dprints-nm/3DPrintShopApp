@{
    ViewData["Title"] = "Track Your Custom Quote";
}

<div class="container my-5" style="max-width: 550px;">
    <div class="card shadow-sm border-0 p-4 rounded-3 bg-white">
        <div class="text-center mb-4">
            <div class="text-primary mb-2">
                <svg xmlns="http://w3.org" width="48" height="48" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                </svg>
            </div>
            <h3 class="fw-bold text-dark">Track Quote Status</h3>
            <p class="text-muted small">Enter the email address you used when submitting your custom 3D printing parameters to pull up real-time slicing metrics and calculations.</p>
        </div>

        <form asp-action="LookupResults" method="post">
            <div class="mb-4">
                <label class="form-label fw-semibold small">Your Account Email</label>
                <input type="email" name="customerEmail" class="form-control form-control-lg shadow-sm" required placeholder="name@example.com" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold text-uppercase shadow-sm">
                Check My Request Status
            </button>
        </form>
    </div>
</div>
