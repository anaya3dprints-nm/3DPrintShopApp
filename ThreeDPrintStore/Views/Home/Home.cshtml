@model List<ThreeDPrintStore.Models.NationalDay>

@{
    ViewData["Title"] = "Home";
}


    <img src="/images/bizlogo.png" alt="Anaya 3D Prints Logo" class="img-fluid mb-3 mx-auto d-block" style="max-width: 200px;">
<div class="container p-5 my-5 bg-dark text-white text-center">
    <h1>Welcome to Anaya 3D Prints</h1>
    <p class="lead">
        My name is Ayana, which is my mom's last name ("Anaya") spelled
        backwards. Because people have accidentlly miscalled me Anaya my entire life, I turned a lifelong
        running joke into the identity of my 3D business.
    </p>
</div>

<div class="container p-5 my-5 bg-dark text-white text-center">
    <h1>Finding Prints Around Albuquerque</h1>
        <p class="lead">
                        You might have found me on TikTok dropping 3D models randomly around the city! Instead of 
            trashing imperfect prints or models that didn’t turn out quite right, I hide them for people 
            to discover. I also don’t believe in profiting off someone else’s creative designs, so leaving 
            them out gives these prints a second life. Whoever finds one is completely free to keep it, 
            gift it, or do whatever they want with it.
        </p>
</div>

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Choose Your Delivery Adventure</h2>
        <p class="text-muted fs-5">Whether you are a local in the Duke City or shopping from afar, we have a delivery path for you.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Card 1: Standard Shipping -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3">
                        <span class="badge bg-secondary px-3 py-2 rounded-pill fs-7">Outside Albuquerque</span>
                    </div>
                    <h3 class="card-title h4 fw-bold mb-3">📦 Standard Shipping</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Live outside of ABQ? No problem. Standard postal shipping is automatically calculated at checkout to bring my custom, hand-designed 3D models straight to your doorstep.
                    </p>
                    <div class="mt-4">
                        <span class="text-dark fw-bold">Calculated at Checkout</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Free Local Delivery -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-2 border-success">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3">
                        <span class="badge bg-success px-3 py-2 rounded-pill fs-7">ABQ Exclusive</span>
                    </div>
                    <h3 class="card-title h4 fw-bold text-success mb-3">🚗 Free Local Delivery</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Live in town and just want your items? Skip the shipping fees entirely! Select this option at checkout for zero-cost local delivery straight to you.
                    </p>
                    <div class="mt-4">
                        <span class="text-success fw-bold fs-5">FREE</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Premium Cache Drop -->
        <div class="col-md-4">
            <div class="card h-100 shadow border-2 border-primary">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3">
                        <span class="badge bg-primary px-3 py-2 rounded-pill fs-7">ABQ Adventure Upgrade</span>
                    </div>
                    <h3 class="card-title h4 fw-bold text-primary mb-3">📍 Premium Cache Drop</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Turn delivery into a game! I will safely hide your package in a secret spot and send private photo/video clues <strong>only to you</strong>. You get your original order <strong>PLUS a free bonus copy</strong> of a community model you sponsor. Your upgrade also funds a separate public twin-drop and a personal shoutout on TikTok!
                    </p>
                    <div class="mt-4">
                        <span class="text-primary fw-bold fs-5">+ Premium Upgrade Fee</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

           

<section class="container my-5">
    <h2 class="text-center mb-4">Upcoming Fun National Holidays</h2>

    @if (Model != null && Model.Any())
    {
        <div class="holiday-scroll-container">

            @foreach (var group in Model.GroupBy(d => d.Date))
            {
                <div class="holiday-card">
                    <h4 class="holiday-date">
                        @group.Key.ToString("dddd, MMMM dd")
                    </h4>

                    <ul class="holiday-list">
                        @foreach (var day in group)
                        {
                            <li class="holiday-item">
                                <span class="holiday-name">@day.Name</span>
                          </li>
                        }
                    </ul>
            
                    <!-- Holiday Image -->
                    @foreach (var day in group)
                    {
                        <img src="@day.Image" alt="@day.Image" style="max-width: 100px; height: auto"/>
                        
                    }
                    
                    </div>
                }

               </div>  
                <p class="text-muted mt-3">
                    A themed 3D print for these holidays will be hidden soon — follow my TikTok for hints!
                </p>

             }
    
    else
    {
        <p class="text-muted text-center">No holidays found this week.</p>
       
    }
</section>

