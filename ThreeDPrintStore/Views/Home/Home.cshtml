
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    /images/bizlogo.png
    <h1 class="fw-bold mb-3">Welcome to Anaya 3D Prints</h1>

    <p class="mt-3 text-muted" style="max-width: 700px; margin: 0 auto;">
        My name is Ayana, which is my mom's last name ("Anaya") spelled
backwards. Because people have accidentlly miscalled me Anaya my entire life, I turned a lifelong
        running joke into the identity of my 3D business.
    </p>
</div>
    <hr />

<div class="container my-5" style="max-width: 900px;">
        <div class="card shadow-sm p-4 rounded-3">
            <h3 class="fw-bold text-dark mb-3">Finding Prints Around Albuquerque</h3>
                
                    <p class="text-muted">
                        You might have found me on TikTok dropping 3D models randomly around the city! Instead of 
            trashing imperfect prints or models that didn’t turn out quite right, I hide them for people 
            to discover. I also don’t believe in profiting off someone else’s creative designs, so leaving 
            them out gives these prints a second life. Whoever finds one is completely free to keep it, 
            gift it, or do whatever they want with it.
                        </p>
                </div>
            </div>

        <div class="card shadow-sm p-4 rounded-3 mt-4">
            <h4 class="fw-bold text-dark mb-2">Standard Shipping</h4>
            <div class="card shadow-sm">
                    <p class="text-muted mb-0"> 
                Perfect for customers who want their prints delivered straight to their door. Available for 
                    all locations outside Albuquerque and for anyone who prefers traditional delivery.
                    </p>
                </div>
            </div>
        

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Track Your Quote</h4>
                    <p class="card-text">Check the status of your custom print request.</p>
                    Track Quote
                </div>
            </div>
        </div>
    </div>
</div>
