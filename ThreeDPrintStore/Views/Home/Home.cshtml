
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <h1 class="fw-bold mb-3">Welcome to Anaya 3D Prints</h1>

    <p class="lead">
        Your local Albuquerque 3D printing services specializing in custom models and cultural designs.
        Explore my catalog or request a custom print today!
    </p>

    <hr />

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Browse Catalog</h4>
                    <p class="card-text">See all in‑stock models and New Mexico‑themed 3D prints.</p>
                    Catalog
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Request a Custom Model</h4>
                    <p class="card-text">Submit your own design or idea and receive a personalized quote.</p>
                    Custom Request
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Track Your Quote</h4>
                    <p class="card-text">Check the status of your custom print request.</p>
                    Track Quote
                </div>
            </div>
        </div>
    </div>
</div>
