@{
    ViewData["Title"] = "3D Print Catalog";
}

<div class="container py-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">3D Print Catalog</h1>
        <p class="lead text-muted">Browse ready-to-ship models printed with high-speed precision.</p>
    </div>

    <!-- Featured Product Cards Grid -->
    <div class="row mb-5">
        <!-- Item 1: La Llorona Duck -->
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm border-0">
                 <img src="~/images/lallorona.jpg"
                            class="card-img-top"
                        alt="La Llorona Duck" />
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-success mb-2 w-auto align-self-start">In Stock</span>
                    <h5 class="card-title fw-bold">La Llorona Duck</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Inspired by Southwestern folklore with a spooky 3D-printed twist.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="1" />
                        <input type="hidden" name="name" value="La Llorona Duck" />
                        <input type="hidden" name="price" value="5" />
                        <button type="submit" class="btn btn-sm btn-primary px-3">Add To Cart</button>
                    </form>
                
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 2: Roswell Alien Duck -->
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm border-0">
                 <img src="~/images/alien.jpg"
            class="card-img-top"
             alt="Roswell Alien Duck" />
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-warning text-dark mb-2 w-auto align-self-start">Limit 5 Per Order</span>
                    <h5 class="card-title fw-bold">Roswell Alien Duck</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        Features iconic extraterrestrial styling in high-speed PLA.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="2" />
                        <input type="hidden" name="name" value="Roswell Alien Duck" />
                        <input type="hidden" name="price" value="5" />
                        <button type="submit" class="btn btn-sm btn-primary px-3">Add To Cart</button>
                    </form>
                        
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 3: Green Chile Duck -->
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm border-0">
                 <img src="~/images/greenchile.jpg"
                    class="card-img-top"
                    alt="Green Chile Duck" />
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-success mb-2 w-auto align-self-start">In Stock</span>
                    <h5 class="card-title fw-bold">Green Chile Duck</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        A playful tribute combining New Mexico's iconic green chile with a classic duck design.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                     
                        <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="3" />
                        <input type="hidden" name="name" value="Green Chile Duck" />
                        <input type="hidden" name="price" value="5" />
                        <button type="submit" class="btn btn-sm btn-primary px-3">Add To Cart</button>
                    </form>
                        
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 4: Red Chile Duck -->
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm border-0">
                 <img src="~/images/redchile.jpg"
                    class="card-img-top"
                        alt="Red Chile Duck" />
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-warning text-dark mb-2 w-auto align-self-start">Limit 5 Per Order</span>
                    <h5 class="card-title fw-bold">Red Chile Duck</h5>
                    <p class="card-text text-muted small flex-grow-1">
                        A whimsical 3D-printed collectible fusion of New Mexico red chile culture.
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                       
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="4" />
                        <input type="hidden" name="name" value="Red Chile Duck" />
                        <input type="hidden" name="price" value="5" />
                        <button type="submit" class="btn btn-sm btn-primary px-3">Add To Cart</button>
                    </form>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    </div>
</div>
<style>
    .card-img-top {
        height: 250px;
        object-fit: cover;
        border-top-left-radius: .375rem;
        border-top-right-radius: .375rem;
    }
</style>

}