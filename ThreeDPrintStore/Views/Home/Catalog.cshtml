@{
    ViewData["Title"] = "3D Print Catalog";
}
<div class="container py-5">
    <h1>3D Print Catalog</h1>
    <p>Browse ready-to-ship models. Contact us for dimensions, colors and production time.</p>
    <div class="row">
        @foreach (var product in ProductCatalog.Products)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="~/images/@product.Image" class="card-img-top" alt="@product.Name" />
                    <div class="card-body">
                        <h2 class="h5">@product.Name</h2>
                        <p>@product.Description</p>
                        <p>$@((product.PriceCents / 100m).ToString("F2"))</p>
                        @if (product.MaxQuantity == 5) { <p>Limit 5 per order.</p> }
                        <form asp-controller="Cart" asp-action="AddAjax" method="post" class="add-cart-form">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <button class="btn btn-primary" type="submit">Add to cart</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
<script>
document.querySelectorAll('.add-cart-form').forEach(form => form.addEventListener('submit', async event => {
    event.preventDefault();
    try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!response.ok) { alert('Unable to add this item. Check the quantity limit.'); return; }
        const result = await response.json();
        const count = document.getElementById('cart-count');
        if (count) count.textContent = result.cartCount;
        alert('Added to cart.');
    } catch { alert('Unable to add this item. Please try again.'); }
}));
</script>
}
