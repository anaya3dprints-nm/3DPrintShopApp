@model IEnumerable<ThreeDPrintStore.Models.Quote>

@{
    ViewData["Title"] = "Admin Calibration Hub";
}

<div class="container-fluid my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold text-dark m-0">Admin Slicing Desk</h1>
            <p class="text-muted mb-0">Review incoming client requests, input material usage metrics, and execute pricing formulations.</p>
        </div>
        <span class="badge bg-dark px-3 py-2 fs-6 shadow-sm">Solo Workstation Active</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-5 border-0 shadow-sm rounded-3">
            <h5 class="fw-bold text-muted mb-1">No Custom Inquiries Filed</h5>
            <p class="text-muted small mb-0">When users submit custom quote request entries, they will populate inside this console dashboard.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var request in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">

                        <!-- Header -->
                        <div class="card-header border-0 d-flex justify-content-between align-items-center py-3 
                             @(request.Status == "Pending" ? "bg-warning text-dark" :
                               request.Status == "Accepted" ? "bg-info text-dark" :
                               request.Status == "Paid" ? "bg-primary text-white" :
                               request.Status == "Printed" ? "bg-dark text-white" :
                               request.Status == "Completed" ? "bg-success text-white" :
                               "bg-secondary text-white")">

                            <span class="fw-bold">Inquiry ID: #@request.Id</span>

                            <span class="badge rounded-pill fw-bold text-uppercase 
                                 @(request.Status == "Pending" ? "bg-dark text-white" :
                                   request.Status == "Accepted" ? "bg-info text-dark" :
                                   request.Status == "Paid" ? "bg-primary text-white" :
                                   request.Status == "Printed" ? "bg-dark text-white" :
                                   request.Status == "Completed" ? "bg-success text-white" :
                                   "bg-secondary text-white")">
                                @request.Status
                            </span>

                        </div>

                        <!-- Body -->
                        <div class="card-body">

                            <!-- Customer Info -->
                            <p class="mb-1"><strong>Email:</strong> @request.CustomerEmail</p>

                            <!-- Timestamps -->
                            @if (request.PrintedAt != null)
                            {
                                <p class="mb-1 text-muted"><strong>Printed At:</strong> @request.PrintedAt</p>
                            }

                            @if (request.CompletedAt != null)
                            {
                                <p class="mb-1 text-muted"><strong>Completed At:</strong> @request.CompletedAt</p>
                            }

                            <!-- Action Buttons -->
                            <div class="mt-3 d-flex gap-3">

                                @* If the user just paid, admin may print *@
                                @if (request.Status == "Paid")
                                {
                                    <a class="btn btn-primary btn-sm" href="/Quote/MarkAsPrinted/@request.Id">
                                        Mark as Printed
                                    </a>
                                }

                                @* If printed, allow completion *@
                                @if (request.Status == "Printed")
                                {
                                    <a class="btn btn-success btn-sm" href="/Quote/MarkAsCompleted/@request.Id">
                                        Mark as Completed
                                    </a>
                                }

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
