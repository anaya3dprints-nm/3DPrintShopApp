@model IEnumerable<ThreeDPrintStore.Models.QuoteRequest>

@{
    ViewData["Title"] = "Admin Calibration Hub";
}

<div class="container-fluid my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold text-dark m-0">Admin Slicing Desk</h1>
            <p class="text-muted mb-0">Review incoming client requests, input material usage metrics, and execute pricing formulations.</p>
        </div>
        <span class="badge bg-dark px-3 py-2 fs-6 shadow-sm">Solo Workstation Active</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-5 border-0 shadow-sm rounded-3">
            <h5 class="fw-bold text-muted mb-1">No Custom Inquiries Filed</h5>
            <p class="text-muted small mb-0">When users submit custom quote request entries, they will populate inside this console dashboard.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var request in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                        <div class="card-header border-0 d-flex justify-content-between align-items-center py-3 @(request.Status == "Pending" ? "bg-warning text-dark" : "bg-success text-white")">
                            <span class="fw-bold">Inquiry ID: #@request.Id</span>
                            <span class="badge rounded-pill fw-bold text-uppercase @(request.Status == "Pending" ? "bg-dark text-white" : "bg-light text-success")">
                                @request.Status
                            </span>
                        </div>

                        <div class="card-body p-4 bg-white">
                            <div class="row g-4">
                                <!-- Col 1: Client Specs -->
                                <div class="col-md-5 border-end">
                                    <h6 class="fw-bold text-secondary text-uppercase small mb-3">Client Parameters</h6>
                                    <table class="table table-sm table-borderless small mb-0">
                                        <tr><th class="ps-0 py-1" style="width: 35%;">Client Email:</th><td class="text-dark py-1">@request.CustomerEmail</td></tr>
                                        <tr><th class="ps-0 py-1">Dimensions:</th><td class="text-dark py-1">@request.Size</td></tr>
                                        <tr><th class="ps-0 py-1">Material Profiles:</th><td class="text-dark py-1"><span class="badge bg-light text-dark border">@request.FilamentType</span></td></tr>
                                        <tr><th class="ps-0 py-1">Color Scheme:</th><td class="text-dark py-1">@request.Color</td></tr>
                                        <tr><th class="ps-0 py-1">Fulfillment Target:</th><td class="text-dark py-1">@request.ShippingCity, @request.PostalCode</td></tr>
                                    </table>
                                    
                                    <div class="mt-3 bg-light p-3 rounded-2">
                                        <div class="fw-bold small text-secondary mb-1">Client Notes:</div>
                                        <p class="mb-0 text-dark small" style="white-space: pre-wrap;">@request.Description</p>
                                    </div>
                                </div>

                                <!-- Col 2: Image Reference -->
                                <div class="col-md-3 border-end text-center d-flex flex-column justify-content-center align-items-center">
                                    <h6 class="fw-bold text-secondary text-uppercase small mb-2 align-self-start">Reference Image</h6>
                                    @if (!string.IsNullOrEmpty(request.ReferenceImagePath))
                                    {
                                        <a href="@request.ReferenceImagePath" target="_blank">
                                            <img src="@request.ReferenceImagePath" class="img-thumbnail rounded shadow-sm" style="max-height: 140px; max-width: 100%; object-fit: contain;" alt="Reference Asset" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted p-4 border rounded-3 bg-light w-100 d-flex align-items-center justify-content-center" style="border-style: dashed !important; min-height: 120px;">
                                            <span class="small">No image uploaded</span>
                                        </div>
                                    }
                                </div>

                                <!-- Col 3: Slicer Inputs & Actions Matrix -->
                                <div class="col-md-4 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-secondary text-uppercase small mb-3">Pricing Calculator Action</h6>
                                        
                                        @if (request.Status == "Pending")
                                        {
                                            <form asp-action="CalculateQuote" method="post" class="row g-2">
                                                <input type="hidden" name="quoteId" value="@request.Id" />
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold mb-1">Material (Grams)</label>
                                                    <input type="number" step="0.1" name="gramsUsed" class="form-control form-control-sm" required placeholder="e.g. 145" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold mb-1">Print Duration (Hrs)</label>
                                                    <input type="number" step="0.1" name="printHours" class="form-control form-control-sm" required placeholder="e.g. 6.5" />
                                                </div>
                                                <div class="col-12 mt-3">
                                                    <button type="submit" class="btn btn-dark btn-sm w-100 fw-bold text-uppercase py-2">
                                                        Run Calculations Matrix
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="p-3 border rounded-3 bg-light">
                                                <div class="d-flex justify-content-between mb-1 small text-muted">
                                                    <span>Print Cost:</span>
                                                    <span class="fw-bold text-dark">$@request.CalculatedPrice.ToString("F2")</span>
                                                </div>
                                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom small text-muted">
                                                    <span>Fulfillment:</span>
                                                    @if (request.ShippingFee == 0)
                                                    {
                                                        <span class="text-success fw-bold">Free Local ABQ Delivery</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-dark fw-bold">$@request.ShippingFee.ToString("F2") Shipping</span>
                                                    }
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center text-dark fw-bold fs-5 pt-1">
                                                    <span>Total Invoice:</span>
                                                    <span class="text-success">$@((request.CalculatedPrice + request.ShippingFee).ToString("F2"))</span>
                                                </div>
                                            </div>

                                            <div class="mt-3">
                                                <button class="btn btn-outline-success btn-sm w-100 fw-semibold" onclick="alert('Copy details to email @request.CustomerEmail\n\nTotal Bill: $@((request.CalculatedPrice + request.ShippingFee).ToString("F2"))')">
                                                    Send Quote to Customer
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
