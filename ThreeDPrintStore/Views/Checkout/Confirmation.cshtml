@model ThreeDPrintStore.Models.Order

@{
    ViewData["Title"] = "Order Success";
}

<div class="container my-5 text-center" style="max-width: 600px;">
    <div class="card p-5 border-0 shadow-sm rounded-3 bg-white">
        
        <!-- Success Check Icon -->
        <div class="text-success mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-bag-check-fill" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M10.5 3.5a2.5 2.5 0 0 0-5 0V4h5v-.5zm1 0V4h1.5v10a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2V4H5v-.5a3.5 3.5 0 1 1 7 0zm-.646 5.354a.5.5 0 0 0-.708-.708L7.5 10.793 6.354 9.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0l3-3z"/>
            </svg>
        </div>

        <h2 class="fw-bold text-dark">Order Confirmed!</h2>
        <p class="text-muted small">Your transaction has been recorded and processed successfully.</p>

        <!-- Order Summary Details -->
        <div class="bg-light p-4 rounded-3 text-start my-4">
            
            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Invoice Reference:</span>
                <strong class="text-dark">#@Model.Id</strong>
            </div>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Customer Email:</span>
                <strong class="text-dark">@(Model.EmailAddress ?? "N/A")</strong>
            </div>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Shipping Destination:</span>
                <strong class="text-dark">@(string.IsNullOrEmpty(Model.City) ? "Local Pickup" : Model.City)</strong>
            </div>

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-muted">Fulfillment Class:</span>
                @if (Model.DeliveryType == "PremiumCacheDrop")
                {
                    <span class="text-primary fw-bold">Premium Cache Drop Upgrade</span>
                }
                else if (Model.DeliveryType == "FreeDelivery")
                {
                    <span class="text-success fw-bold">ABQ Free Local Delivery</span>
                }
                else
                {
                    <span class="text-secondary fw-bold">Standard Shipping</span>
                }
            </div>

            <hr class="my-3">

            <div class="d-flex justify-content-between small mb-1">
                <span class="text-muted">Subtotal:</span>
                <span>@Model.Subtotal.ToString("C")</span>
            </div>

            @if (Model.ShippingFee > 0)
            {
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Shipping Fee:</span>
                    <span>@Model.ShippingFee.ToString("C")</span>
                </div>
            }

            @if (Model.CacheUpgradeFee > 0)
            {
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Cache Upgrade Fee:</span>
                    <span>@Model.CacheUpgradeFee.ToString("C")</span>
                </div>
            }

            <div class="d-flex justify-content-between fw-bold text-success fs-5 mt-2 pt-2 border-top">
                <span>Total Paid:</span>
                <span>@Model.AmountPaid.ToString("C")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.StripePaymentIntentId))
            {
                <div class="d-flex justify-content-between small text-muted mt-2">
                    <span>Payment Ref:</span>
                    <span class="font-monospace">@Model.StripePaymentIntentId</span>
                </div>
            }
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold py-2">
            Return to Store
        </a>
    </div>
</div>