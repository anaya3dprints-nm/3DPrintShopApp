@model ThreeDPrintStore.Models.Order

@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container my-5">
    <div class="row g-5">
        <!-- Col 1: Delivery Address Form Parameters -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 p-4 rounded-3 bg-white">
                <h4 class="fw-bold mb-3 text-dark">Fulfillment Delivery Address</h4>
                <form asp-action="PlaceOrder" method="post">
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Full Name</label>
                        <input asp-for="CustomerName" class="form-control" required placeholder="Jane Doe" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email Address</label>
                        <input type="email" asp-for="CustomerEmail" class="form-control" required placeholder="jane@example.com" />
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Street Address</label>
                        <input asp-for="StreetAddress" class="form-control" required placeholder="123 Central Ave NE" />
                        <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">City</label>
                            <input asp-for="City" class="form-control" required placeholder="Albuquerque" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">ZIP Code</label>
                            <input asp-for="PostalCode" class="form-control" required placeholder="87102" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                                        <!-- START OF DYNAMIC DELIVERY OPTIONS -->
                <div class="mt-4 pt-3 border-top">
                    <h5 class="fw-bold mb-3 text-secondary">Fulfillment Options</h5>
                    
                    <!-- Standard Shipping (Always Visible by default) -->
                    <div class="form-check p-3 border rounded mb-2 bg-light d-flex align-items-center" id="shipping-option-container">
                        <input class="form-check-input ms-0 me-3" type="radio" asp-for="DeliveryType" value="Shipping" id="deliveryShipping" checked>
                        <label class="form-check-label w-100" for="deliveryShipping">
                            <span class="fw-bold d-block">📦 Standard Mail Shipping</span>
                            <span class="text-muted small">Your custom models are safely packaged and sent directly to your door.</span>
                        </label>
                    </div>

                    <!-- Albuquerque Local Options Container (Hidden by default via d-none) -->
                    <div id="albuquerque-options" class="d-none">
                        <!-- Free Local Delivery -->
                        <div class="form-check p-3 border rounded border-success mb-2 bg-white d-flex align-items-center">
                            <input class="form-check-input ms-0 me-3" type="radio" asp-for="DeliveryType" value="FreeDelivery" id="deliveryFree">
                            <label class="form-check-label w-100" for="deliveryFree">
                                <span class="fw-bold text-success d-block">🚗 Free Local Delivery (ABQ Exclusive)</span>
                                <span class="text-muted small">Skip the shipping fees entirely! Hand-delivered locally at zero extra cost.</span>
                            </label>
                        </div>

                        <!-- Premium Cache Drop -->
                        <div class="form-check p-3 border rounded border-primary mb-2 bg-white d-flex align-items-center">
                            <input class="form-check-input ms-0 me-3" type="radio" asp-for="DeliveryType" value="PremiumCacheDrop" id="deliveryCache">
                            <label class="form-check-label w-100" for="deliveryCache">
                                <span class="fw-bold text-primary d-block">📍 Premium Cache Drop Scavenger Hunt</span>
                                <span class="text-muted small">Turn delivery into a game! I'll hide your package safely and send a private photo/video clue <strong>only to you</strong>. Includes your order PLUS a bonus copy of the community model you sponsor!</span>
                            </label>
                        </div>

                        <!-- Conditional Community Model Selection (Hidden unless Premium Cache Drop is checked) -->
                        <div id="community-model-selection" class="mt-2 p-3 bg-light border rounded border-primary d-none">
                            <label class="form-label fw-bold text-primary small mb-1" for="SponsoredCommunityModelId">Choose Your Sponsored Community Model Drop:</label>
                            <select class="form-select form-select-sm" asp-for="SponsoredCommunityModelId">
                                <option value="1">Mini Octopus</option>
                                <option value="2">Articulated Dragon</option>
                                <option value="3">Low-Poly Skull</option>
                                <option value="4">Surprise Me!</option>
                            </select>
                            <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">Your selection dictates the twin duplicate model hidden publicly for the city TikTok hunt!</span>
                        </div>
                    </div>
                </div>
                <!-- END OF DYNAMIC DELIVERY OPTIONS -->

                        
                    </div>

                    <div class="checkout-terms-section">
                        <h3>Before completing your order:</h3>
                        <p>
                            By checking the box below, you agree to our Checkout Summary, Terms & Conditions,
                            and Privacy Policy. Custom orders are non-refundable, shipping timelines may vary, and
                            any dmage must be reported within 7 days. You confirm that all information you provide is accurate
                            and that any custom designs submitted are owned by you or legally allowed.
                        </p>

                    <div class="form-check">
                        <input type="checkbox" id="AgreeToTerms" required />
                        <label for="AgreeToTerms">
                            I agree to the Checkout Summary, Terms & Conditions, and Privacy Policy.
                        </label>
                    </div>
                </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold text-uppercase shadow-sm">
                        Place Final Order
                    </button>
                </form>
            </div>
        </div>

        <!-- Col 2: Pricing Summary Panel Box -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 p-4 rounded-3 bg-light position-sticky" style="top: 20px;">
                <h5 class="fw-bold mb-3 text-dark">Order Pricing Invoice</h5>
                
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Items Subtotal:</span>
                    <span class="fw-semibold text-dark">$@Model.Subtotal.ToString("F2")</span>
                </div>
                
                <div class="alert alert-info border-0 p-2 my-3 rounded small">
                    ℹ️ Shipping logic estimates drop fees instantly based on the city matching inputs provided. <strong>Free delivery applies across Albuquerque!</strong>
                </div>

                <div class="d-flex justify-content-between pt-3 border-top text-dark fw-bold fs-5">
                    <span>Grand Total:</span>
                    <span class="text-success">$@Model.Subtotal.ToString("F2")*</span>
                </div>
                <small class="text-muted d-block text-end mt-1">*Final delivery cost updated upon layout execution submission.</small>
            </div>
        </div>
    </div>
</div>
