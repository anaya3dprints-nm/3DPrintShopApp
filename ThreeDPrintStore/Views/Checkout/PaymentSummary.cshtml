@model ThreeDPrintStore.Models.Order

@{
    ViewData["Title"] = "Secure Payment";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4">
        <div class="text-center mb-4">
            <h2 class="fw-bold">💳 Secure Checkout</h2>
            <p class="text-muted">Review your invoice details and complete your transaction.</p>
        </div>

        <!-- 1. Itemized Invoice Summary -->
        <div class="bg-light p-3 rounded mb-4">
            <h5 class="fw-bold mb-3 text-secondary">Order Summary</h5>
            <div class="d-flex justify-content-between mb-2">
                <span>Items Subtotal:</span>
                <span class="fw-semibold">@Model.Subtotal.ToString("C")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Fulfillment Type (@Model.DeliveryType):</span>
                <span class="fw-semibold text-success">@Model.ShippingFee.ToString("C")</span>
                4
            </div>
            @if (Model.CacheUpgradeFee > 0)
            {
                <div class="d-flex justify-content-between mb-2 text-primary">
                    <span>Premium Cache Drop Fee:</span>
                    <span class="fw-semibold">+@Model.CacheUpgradeFee.ToString("C")</span>
                </div>
            }
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-5 fw-bold">Amount Due:</span>
                <span class="fs-4 fw-bold text-success">@Model.GrandTotal.ToString("C")</span>
            </div>
        </div>

        <!-- 2. Secure Card Payment Form Sandbox -->
        <form asp-action="ProcessSecurePayment" method="post">
            <h5 class="fw-bold mb-3 text-secondary">Cardholder Information</h5>
            
            <div class="mb-3">
                <label class="form-label small fw-semibold">Name on Card</label>
                <input type="text" class="form-control" placeholder="Alex Jackson" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Card Number</label>
                <div class="input-group">
                    <span class="input-group-text">💳</span>
                    <input type="text" class="form-control" placeholder="4111 2222 3333 4444" maxlength="19" required />
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label small fw-semibold">Expiration Date</label>
                    <input type="text" class="form-control" placeholder="MM/YY" maxlength="5" required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label small fw-semibold">CVV Security Code</label>
                    <input type="password" class="form-control" placeholder="***" maxlength="4" required />
                </div>
            </div>

             <div class="alert alert-info py-2 px-3 small border-0 mt-2" role="alert">
                ℹ️ This is a secure checkout testing sandbox. You can provide mock payment values to advance.
            </div>

            <!-- Submit Final Authorization Payment Request -->
            <button type="submit" class="btn btn-success btn-lg w-100 mt-3 fw-bold">
                🔒 AUTHORIZE & COMPLETE PAYMENT (@Model.GrandTotal.ToString("C"))
            </button>
        </form>
    </div>
</div>